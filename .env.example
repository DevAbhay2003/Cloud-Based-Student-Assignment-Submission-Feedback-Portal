# Cloud Environment Configuration
PORT=8000
ENVIRONMENT=development
JWT_SECRET=super_secure_cloud_jwt_secret_key_change_in_production_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (SQLite default for local free-tier, PostgreSQL / Supabase supported)
DATABASE_URL=sqlite:///./portal.db

# Storage Provider: "local" (default local simulation), "s3" (AWS/MinIO), "supabase" (Supabase Storage)
STORAGE_PROVIDER=local
STORAGE_BUCKET_PATH=./cloud_storage_bucket
MAX_FILE_SIZE_MB=25

# Optional AWS / Cloud Storage Credentials (when STORAGE_PROVIDER=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=student-assignment-portal-bucket

# Client Origin (CORS)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000,http://localhost:8000
